[{"term":"2FA","full":"Two-Factor Authentication","ko":"이중 요소 인증","definition":"서로 다른 두 종류의 인증 근거를 쓰는 다중 요소 인증. 인증 절차의 화면 수를 세는 말이 아니다.","target":"security--mfa-passkeys","aliases":[],"targets":["security--mfa-passkeys"]},{"term":"ABAC","full":"Attribute-Based Access Control","ko":"속성 기반 접근 제어","definition":"사용자·대상·작업·환경의 속성과 정책을 평가해 접근 여부를 판단하는 방식.","target":"security--rbac-abac","aliases":[],"targets":["security--rbac-abac"]},{"term":"ABI","full":"Application Binary Interface","ko":"응용 프로그램 바이너리 인터페이스","definition":"컴파일된 코드끼리 연결할 때 지켜야 하는 호출 규약·자료 배치·파일 형식 등의 규칙.","target":"delivery--cross-build","aliases":[],"targets":["delivery--cross-build"]},{"term":"ACID","full":"Atomicity, Consistency, Isolation, Durability","ko":"원자성·일관성·격리성·지속성","definition":"트랜잭션의 전부 또는 전무, 제약 유지, 동시 실행 간 분리, 확정 결과의 보존을 구분하는 성질 묶음.","target":"storage--storage-transaction","aliases":[],"targets":["storage--storage-transaction"]},{"term":"ACK","full":"Acknowledgment","ko":"확인 응답","definition":"수신 또는 처리를 확인하는 메시지. 어느 단계까지 확인하는지 프로토콜에서 정해야 한다.","target":"game-online--game-online-sequence","aliases":[],"targets":["game-online--game-online-sequence","networks--tcp-lifecycle"]},{"term":"ACL","full":"Access Control List","ko":"접근 제어 목록","definition":"파일 같은 대상에 대해 어떤 사용자·그룹이 어떤 작업을 할 수 있는지 나열한 권한 규칙.","target":"environment--directory-rights","aliases":[],"targets":["environment--directory-rights","security--retrieval-access"]},{"term":"AGENTS.md","full":"AGENTS.md","ko":"개발 에이전트용 프로젝트 지침","definition":"프로젝트 실행·검증 명령과 관례를 기록하는 파일 형식. 로딩 범위와 우선순위는 도구에서 확인한다.","target":"ai-workflow--reusable-instructions","aliases":[],"targets":["ai-workflow--reusable-instructions"]},{"term":"ALU","full":"Arithmetic Logic Unit","ko":"산술·논리 연산 장치","definition":"CPU 안에서 덧셈·비교·논리 연산 등을 수행하는 실행 회로. CPU 전체와 같은 뜻은 아니다.","target":"runtime--cpu","aliases":[],"targets":["runtime--cpu"]},{"term":"AoS","full":"Array of Structures","ko":"구조체 배열","definition":"객체 하나의 여러 필드를 묶은 구조체들을 배열로 배치하는 방식. 한 객체의 필드를 함께 읽을 때의 지역성을 고려한다.","target":"runtime--data-layout","aliases":["AOS"],"targets":["runtime--data-layout"]},{"term":"API","full":"Application Programming Interface","ko":"응용 프로그램 인터페이스","definition":"다른 코드나 시스템이 기능을 호출할 때 따라야 하는 입력·출력·실패·의미의 계약.","target":"architecture--architecture-contract","aliases":[],"targets":["architecture--architecture-contract"]},{"term":"ASan","full":"AddressSanitizer","ko":"주소 오류 검사기","definition":"잘못된 메모리 접근 등을 실행 중 검사하도록 계측하는 도구.","target":"debugging--memory-sanitizer","aliases":[],"targets":["debugging--memory-sanitizer"]},{"term":"AST","full":"Abstract Syntax Tree","ko":"추상 구문 트리","definition":"연산·호출·조건문 같은 소스 코드의 구조를 트리로 표현한 자료. 공백 등 모든 표기 세부를 보존하는 것은 아니다.","target":"runtime--syntax-tree","aliases":[],"targets":["runtime--syntax-tree"]},{"term":"BDP","full":"Bandwidth–Delay Product","ko":"대역폭·지연 곱","definition":"목표 전송률에 왕복 시간을 곱한 데이터 양. 전송로를 채우는 데 필요한 진행 중 데이터 규모를 가늠한다.","target":"networks--bandwidth-delay","aliases":[],"targets":["networks--bandwidth-delay"]},{"term":"BERT","full":"Bidirectional Encoder Representations from Transformers","ko":"트랜스포머의 양방향 인코더 표현","definition":"입력의 양쪽 문맥을 참고하는 사전학습 표현 모델.","target":"ai-papers--bert","aliases":[],"targets":["ai-papers--bert"]},{"term":"BFS","full":"Breadth-First Search","ko":"너비 우선 탐색","definition":"큐를 이용해 시작점과 간선 수가 가까운 층부터 방문하는 탐색.","target":"data--data-traversal","aliases":[],"targets":["data--data-traversal"]},{"term":"BST","full":"Binary Search Tree","ko":"이진 탐색 트리","definition":"각 노드의 키를 기준으로 작은 키와 큰 키를 서로 다른 하위 트리에 두는 구조.","target":"data--data-bst","aliases":[],"targets":["data--data-bst"]},{"term":"CAP","full":"Consistency, Availability, Partition Tolerance","ko":"일관성·가용성·분할 내성","definition":"네트워크 분할 중 선형화 가능한 단일 상태와 모든 정상 노드의 요청 완료를 동시에 보장하는 데 한계가 있다는 정리의 세 속성.","target":"architecture--architecture-partition","aliases":[],"targets":["architecture--architecture-partition"]},{"term":"CAS","full":"Compare-and-Swap","ko":"비교 후 교환","definition":"현재 값이 예상 값과 같은 경우에만 새 값으로 바꾸고 성공 여부를 알리는 원자적 연산.","target":"concurrency--compare-swap","aliases":[],"targets":["concurrency--compare-swap"]},{"term":"CBOW","full":"Continuous Bag-of-Words","ko":"연속 단어 주머니","definition":"주변 단어들의 표현에서 가운데 단어를 예측하는 word2vec 학습 구조.","target":"ai-papers--word2vec","aliases":[],"targets":["ai-papers--word2vec"]},{"term":"CCD","full":"Continuous Collision Detection","ko":"연속 충돌 검출","definition":"이동 전후 위치뿐 아니라 사이 경로의 충돌을 검사하는 방식.","target":"game--game-collision","aliases":[],"targets":["game--game-collision"]},{"term":"CD","full":"Continuous Delivery / Continuous Deployment","ko":"지속적 제공 / 지속적 배포","definition":"Delivery는 검증된 변경을 배포 가능한 상태로 유지하는 방식이고, Deployment는 통과한 변경의 운영 배포까지 자동화하는 방식.","target":"delivery--environments","aliases":[],"targets":["delivery--environments"]},{"term":"CDN","full":"Content Delivery Network","ko":"콘텐츠 전송 네트워크","definition":"여러 위치의 캐시 등으로 사용자에게 콘텐츠를 전달하는 네트워크.","target":"infra--persistent-storage","aliases":[],"targets":["infra--persistent-storage"]},{"term":"cgroup","full":"Control Group","ko":"제어 그룹","definition":"Linux에서 프로세스 집합의 자원 사용을 계측·제한하는 커널 기능.","target":"infra--cpu-quota","aliases":["cgroups"],"targets":["infra--cpu-quota"]},{"term":"CI","full":"Continuous Integration","ko":"지속적 통합","definition":"변경을 공통 이력에 자주 합치고 빌드·테스트로 통합 결과를 검사하는 개발 방식.","target":"delivery--ci","aliases":[],"targets":["delivery--ci"]},{"term":"CLIP","full":"Contrastive Language-Image Pre-training","ko":"언어·이미지 대조 사전학습","definition":"이미지와 자연어 설명의 올바른 짝을 구별하며 공통 표현을 학습하는 방법.","target":"ai-papers--clip","aliases":[],"targets":["ai-papers--clip"]},{"term":"CNAME","full":"Canonical Name","ko":"정식 이름 별칭 기록","definition":"DNS에서 한 이름을 다른 이름의 별칭으로 연결하는 기록 종류. HTTP 경로나 포트를 설정하지 않는다.","target":"networks--dns-records","aliases":[],"targets":["networks--dns-records"]},{"term":"CORS","full":"Cross-Origin Resource Sharing","ko":"교차 출처 리소스 공유","definition":"서버의 HTTP 헤더를 통해 브라우저가 다른 출처 응답을 페이지 코드에 공개할지를 결정하는 규칙.","target":"networks--cors","aliases":[],"targets":["networks--cors","security--cors-policy"]},{"term":"CPU","full":"Central Processing Unit","ko":"중앙처리장치","definition":"프로그램의 명령을 가져와 해석하고 계산·메모리 접근을 수행하는 범용 처리 장치.","target":"runtime--cpu","aliases":[],"targets":["runtime--cpu"]},{"term":"CQRS","full":"Command Query Responsibility Segregation","ko":"명령·조회 책임 분리","definition":"상태를 변경하는 모델과 조회에 사용하는 모델의 책임을 분리하는 설계.","target":"architecture--architecture-cqrs","aliases":[],"targets":["architecture--architecture-cqrs"]},{"term":"CRUD","full":"Create, Read, Update, Delete","ko":"생성·조회·수정·삭제","definition":"저장된 데이터를 다루는 기본 작업 네 가지. 업무 책임의 경계를 자동으로 정해 주는 분류는 아니다.","target":"architecture--architecture-boundary","aliases":[],"targets":["architecture--architecture-boundary"]},{"term":"CSP","full":"Content Security Policy","ko":"콘텐츠 보안 정책","definition":"브라우저가 읽거나 실행할 수 있는 콘텐츠의 출처·조건 등을 제한하는 추가 방어 정책.","target":"security--csp","aliases":[],"targets":["security--csp"]},{"term":"CSPRNG","full":"Cryptographically Secure Pseudorandom Number Generator","ko":"암호학적으로 안전한 의사 난수 생성기","definition":"보안 목적의 예측 불가능성을 고려한 난수 생성기. 시뮬레이션 재현용 난수와 목적이 다르다.","target":"security--random-secrets","aliases":[],"targets":["security--random-secrets"]},{"term":"CSRF","full":"Cross-Site Request Forgery","ko":"사이트 간 요청 위조","definition":"브라우저가 자동 첨부하는 인증 정보를 이용해 사용자가 의도하지 않은 요청을 유도하는 공격.","target":"security--csrf","aliases":[],"targets":["security--csrf"]},{"term":"CSS","full":"Cascading Style Sheets","ko":"종속형 스타일 시트","definition":"문서 요소가 어떻게 표시되는지 정하는 스타일 규칙.","target":"networks--browser-document","aliases":[],"targets":["networks--browser-document"]},{"term":"DAG","full":"Directed Acyclic Graph","ko":"방향 비순환 그래프","definition":"방향이 있는 간선으로 작업 의존성을 연결하며 순환이 없는 그래프.","target":"ai-workflow--dag","aliases":[],"targets":["ai-workflow--dag"]},{"term":"DB","full":"Database","ko":"데이터베이스","definition":"지속적으로 관리하고 조회·변경할 데이터를 조직한 저장 체계.","target":"storage--storage-choice","aliases":[],"targets":["storage--storage-choice"]},{"term":"DDPM","full":"Denoising Diffusion Probabilistic Models","ko":"잡음 제거 확산 확률 모델","definition":"여러 잡음 수준의 역방향 변환을 학습해 잡음에서 새 표본을 생성하는 모델.","target":"ai-papers--ddpm","aliases":[],"targets":["ai-papers--ddpm"]},{"term":"DFS","full":"Depth-First Search","ko":"깊이 우선 탐색","definition":"한 경로를 깊게 따라가고 돌아와 다음 경로를 방문하는 탐색.","target":"data--data-traversal","aliases":[],"targets":["data--data-traversal"]},{"term":"DLQ","full":"Dead-Letter Queue","ko":"실패 메시지 보관 큐","definition":"반복 처리에 실패한 메시지를 정상 흐름에서 분리해 원인 조사·재처리할 수 있게 보관하는 큐.","target":"architecture--architecture-dlq","aliases":[],"targets":["architecture--architecture-dlq","observability--dead-letter"]},{"term":"DMA","full":"Direct Memory Access","ko":"직접 메모리 접근","definition":"장치가 메모리와 데이터를 주고받는 전송 방식. CPU와 드라이버는 버퍼 준비·소유권·완료 처리를 관리한다.","target":"io--dma","aliases":[],"targets":["io--dma"]},{"term":"DNS","full":"Domain Name System","ko":"도메인 이름 시스템","definition":"도메인 이름에 연결된 주소·별칭 등의 기록을 조회하는 분산 이름 체계.","target":"networks--dns","aliases":[],"targets":["networks--dns"]},{"term":"DOM","full":"Document Object Model","ko":"문서 객체 모델","definition":"문서의 구조·내용을 메모리의 노드와 객체로 다루는 인터페이스. 초기 HTML과 현재 DOM은 다를 수 있다.","target":"networks--browser-document","aliases":[],"targets":["networks--browser-document"]},{"term":"DPO","full":"Direct Preference Optimization","ko":"직접 선호 최적화","definition":"선호·비선호 응답 쌍과 기준 모델 대비 확률비를 이용해 언어 모델을 직접 조정하는 방법.","target":"ai-papers--dpo","aliases":[],"targets":["ai-papers--dpo"]},{"term":"E2E","full":"End-to-End","ko":"종단 간 테스트","definition":"사용자 입력부터 관련 구성 요소를 거친 최종 결과까지 연결해 검사하는 방식.","target":"debugging--e2e","aliases":[],"targets":["debugging--e2e"]},{"term":"E2EE","full":"End-to-End Encryption","ko":"종단 간 암호화","definition":"통신 종단만 내용을 복호화하도록 하는 보호 방식. 전달 서버의 TLS 종료와 다른 경계다.","target":"networks--vpn-boundary","aliases":[],"targets":["networks--vpn-boundary"]},{"term":"eBPF","full":"extended Berkeley Packet Filter","ko":"확장 버클리 패킷 필터","definition":"검증된 프로그램을 커널의 지정된 지점 등에서 실행하는 기술. 관측·네트워크 처리 등 여러 용도로 쓰인다.","target":"debugging--syscall-trace","aliases":[],"targets":["debugging--syscall-trace"]},{"term":"ECS","full":"Entity Component System","ko":"엔티티·컴포넌트·시스템","definition":"정체성인 엔티티, 자료인 컴포넌트, 자료를 처리하는 시스템을 나누는 구성 방식.","target":"game--game-ecs","aliases":[],"targets":["game--game-ecs"]},{"term":"EOF","full":"End Of File","ko":"입력의 끝","definition":"파일 또는 바이트 흐름에서 더 이상 읽을 입력이 없음을 나타낸다. 네트워크에서 미완성 메시지 상태로 EOF를 받으면 정상 메시지로 취급할 수 없다.","target":"networks--framing","aliases":[],"targets":["networks--framing"]},{"term":"EOS","full":"End of Sequence","ko":"시퀀스 종료","definition":"모델이 생성 시퀀스의 끝을 나타내는 데 쓰는 표식. 전송 오류나 출력 길이 제한으로 잘린 응답과 구분한다.","target":"llm--termination","aliases":[],"targets":["llm--termination"]},{"term":"ETag","full":"Entity Tag","ko":"표현 버전 식별자","definition":"HTTP 응답 표현의 버전을 구별하는 값. 캐시 재검증과 If-Match 조건부 변경에 사용한다.","target":"networks--conditional-update","aliases":[],"targets":["networks--conditional-update"]},{"term":"FD","full":"File Descriptor","ko":"파일 디스크립터","definition":"프로세스의 파일 디스크립터 표에서 열린 파일·소켓 등을 가리키는 정수 식별자.","target":"io--file-descriptor","aliases":[],"targets":["io--file-descriptor"]},{"term":"FFN","full":"Feed-Forward Network","ko":"피드포워드 신경망","definition":"트랜스포머에서 각 위치의 특징을 변환하는 신경망. 위치 간 정보를 섞는 어텐션과 구분한다.","target":"llm--ffn","aliases":[],"targets":["llm--ffn"]},{"term":"FIFO","full":"First In, First Out","ko":"선입선출","definition":"먼저 넣은 항목을 먼저 꺼내는 순서. 여러 작업자가 처리하면 꺼낸 순서와 완료 순서는 다를 수 있다.","target":"concurrency--producer-consumer","aliases":[],"targets":["concurrency--producer-consumer"]},{"term":"FIN","full":"Finish","ko":"송신 종료 플래그","definition":"TCP에서 해당 방향으로 더 보낼 데이터가 없음을 알리는 플래그. 반대 방향 수신은 이어질 수 있다.","target":"networks--tcp-lifecycle","aliases":[],"targets":["networks--tcp-lifecycle"]},{"term":"FPS","full":"Frames Per Second","ko":"초당 프레임 수","definition":"1초에 표시하거나 생성하는 화면 프레임 수. 이 장에서는 1인칭 슈팅 장르의 약어가 아니다.","target":"game--game-timestep","aliases":[],"targets":["game--game-timestep"]},{"term":"FSM","full":"Finite State Machine","ko":"유한 상태 기계","definition":"유한한 현재 상태와 입력 사건에 따라 허용된 다음 상태로 이동하는 모델.","target":"state--state-transition","aliases":[],"targets":["state--state-transition"]},{"term":"FUSE","full":"Filesystem in Userspace","ko":"사용자 공간 파일시스템","definition":"파일시스템 요청을 사용자 공간 프로세스가 처리하도록 커널과 연결하는 프레임워크.","target":"io--fuse-mounts","targets":["io--fuse-mounts"]},{"term":"GB","full":"Gigabyte","ko":"기가바이트","definition":"10진 단위로 1GB는 1000000000바이트다. 1073741824바이트인 1GiB와 구분한다.","target":"math--units","aliases":[],"targets":["math--units"]},{"term":"GC","full":"Garbage Collection","ko":"가비지 컬렉션","definition":"프로그램에서 더 이상 도달할 수 없는 객체 등의 메모리를 자동 회수하는 방식.","target":"debugging--memory-leaks","aliases":[],"targets":["debugging--memory-leaks"]},{"term":"GiB","full":"Gibibyte","ko":"기비바이트","definition":"1GiB는 1,073,741,824바이트다. 스트리밍 그림의 10GiB는 10,240MiB다.","target":"io--streaming","aliases":[],"targets":["io--streaming"]},{"term":"GPU","full":"Graphics Processing Unit","ko":"그래픽 처리 장치","definition":"그래픽과 대규모 배열 계산처럼 비슷한 연산을 많은 데이터에 적용하는 데 특화된 처리 장치.","target":"runtime--gpu","aliases":[],"targets":["runtime--gpu"]},{"term":"HA","full":"High Availability","ko":"고가용성","definition":"일부 구성 요소의 장애에도 서비스 중단을 줄이도록 구성하는 성질과 설계.","target":"infra--database-ha","aliases":[],"targets":["infra--database-ha"]},{"term":"HAR","full":"HTTP Archive","ko":"HTTP 통신 기록 형식","definition":"브라우저의 요청·응답과 시간 정보를 내보내는 형식. 인증 정보·본문 등 민감한 자료가 포함될 수 있다.","target":"networks--devtools-network","aliases":[],"targets":["networks--devtools-network"]},{"term":"HDD","full":"Hard Disk Drive","ko":"하드 디스크 드라이브","definition":"회전하는 자기 디스크에 데이터를 기록하는 저장장치. 임의 위치 접근에는 헤드 이동 등의 비용이 든다.","target":"runtime--memory-tiers","aliases":[],"targets":["runtime--memory-tiers"]},{"term":"HMAC","full":"Hash-based Message Authentication Code","ko":"해시 기반 메시지 인증 코드","definition":"암호학적 해시 함수와 비밀키를 조합하는 메시지 인증 코드 방식.","target":"security--mac-signature","aliases":[],"targets":["security--mac-signature"]},{"term":"HOL","full":"Head-of-Line Blocking","ko":"선두 대기","definition":"앞의 데이터가 지연되어 이미 준비된 뒤 데이터도 전달하지 못하는 현상. TCP의 바이트 순서 대기는 HTTP/2의 여러 스트림에 영향을 줄 수 있다.","target":"networks--http-multiplexing","aliases":["HOL blocking"],"targets":["networks--http-multiplexing"]},{"term":"HPA","full":"Horizontal Pod Autoscaler","ko":"수평 파드 자동 확장기","definition":"관측 지표와 목표값을 비교해 Kubernetes 워크로드의 복제본 수를 조절하는 기능.","target":"infra--autoscaling-control","aliases":[],"targets":["infra--autoscaling-control"]},{"term":"HTML","full":"Hypertext Markup Language","ko":"하이퍼텍스트 마크업 언어","definition":"웹 문서의 구조와 의미를 표현하는 마크업 언어.","target":"networks--browser-document","aliases":[],"targets":["networks--browser-document"]},{"term":"HTTP","full":"Hypertext Transfer Protocol","ko":"하이퍼텍스트 전송 프로토콜","definition":"메서드·대상·헤더·본문을 가진 요청과 상태·헤더·본문을 가진 응답으로 자료를 주고받는 규칙.","target":"networks--http-message","aliases":[],"targets":["networks--http-message"]},{"term":"HTTPS","full":"Hypertext Transfer Protocol Secure","ko":"TLS로 보호한 HTTP","definition":"HTTP 통신에 TLS를 적용한 방식. 암호화 외에 인증서와 접속 이름의 검증도 필요하다.","target":"networks--tls","aliases":[],"targets":["networks--tls","security--crypto"]},{"term":"I/O","full":"Input/Output","ko":"입출력","definition":"프로그램과 파일·네트워크·장치 등 사이에서 데이터를 주고받는 작업.","target":"io--io-path","aliases":["IO"],"targets":["io--io-path"]},{"term":"IaC","full":"Infrastructure as Code","ko":"코드형 인프라","definition":"인프라의 목표 구성을 코드로 선언하고 변경 계획·적용·상태를 관리하는 방식.","target":"infra--iac-plan","aliases":[],"targets":["infra--iac-plan"]},{"term":"IAM","full":"Identity and Access Management","ko":"신원 및 접근 관리","definition":"사람·프로그램의 신원과 자원 접근 권한을 관리하는 체계.","target":"infra--workload-identity","aliases":[],"targets":["infra--workload-identity"]},{"term":"ID","full":"Identifier","ko":"식별자","definition":"같은 대상을 계속 구별하기 위해 사용하는 값. 표시 이름이나 목록 위치와 별개다.","target":"data--data-identity","aliases":[],"targets":["data--data-identity"]},{"term":"IDE","full":"Integrated Development Environment","ko":"통합 개발 환경","definition":"편집·탐색·빌드·실행·디버깅 등의 개발 기능을 한 작업 환경에서 제공하는 도구.","target":"environment--editor-navigation","aliases":[],"targets":["environment--editor-navigation"]},{"term":"IEEE","full":"Institute of Electrical and Electronics Engineers","ko":"전기전자공학자협회","definition":"전기·전자·컴퓨팅 분야의 기술 단체. 부동소수점 표현·연산 규칙을 다루는 IEEE 754 같은 표준의 이름에 등장한다.","target":"math--floating","aliases":[],"targets":["math--floating"]},{"term":"initramfs","full":"Initial RAM filesystem","ko":"초기 메모리 파일시스템","definition":"Linux 부팅 초기에 실제 루트 파일시스템을 준비할 도구와 자료를 제공하는 메모리 파일시스템.","target":"runtime--boot-chain","targets":["runtime--boot-chain"]},{"term":"IOPS","full":"Input/Output Operations Per Second","ko":"초당 입출력 작업 수","definition":"정해진 계층에서 1초 동안 처리한 입출력 작업 수. 요청 크기와 함께 보아야 전송량을 계산할 수 있다.","target":"io--iops","aliases":[],"targets":["io--iops"]},{"term":"IP","full":"Internet Protocol","ko":"인터넷 프로토콜","definition":"네트워크 사이에서 주소와 경로를 사용해 패킷을 전달하는 규칙. 포트와 애플리케이션의 처리 결과는 별도다.","target":"networks--ip-port","aliases":[],"targets":["networks--ip-port"]},{"term":"IPC","full":"Interprocess Communication","ko":"프로세스 간 통신","definition":"별도 프로세스들이 파이프·소켓·공유 메모리 등으로 데이터를 주고받는 방식. 공유 데이터에는 별도 동기화가 필요할 수 있다.","target":"runtime--process","aliases":[],"targets":["runtime--process"]},{"term":"IPv4","full":"Internet Protocol version 4","ko":"인터넷 프로토콜 버전 4","definition":"32비트 주소를 사용하는 IP 버전. 문서의 192.0.2.10 같은 표기는 네 구간의 십진수 주소다.","target":"networks--ip-port","aliases":[],"targets":["networks--ip-port"]},{"term":"IPv6","full":"Internet Protocol version 6","ko":"인터넷 프로토콜 버전 6","definition":"128비트 주소를 사용하는 IP 버전. 2001:db8::9 같은 표기를 사용한다.","target":"networks--dns-records","aliases":[],"targets":["networks--dns-records"]},{"term":"IR","full":"Intermediate Representation","ko":"중간 표현","definition":"소스 코드와 최종 기계어 사이에서 분석·최적화·코드 생성에 쓰는 표현. 반드시 하나의 텍스트 형식인 것은 아니다.","target":"runtime--intermediate-code","aliases":[],"targets":["runtime--intermediate-code"]},{"term":"ISA","full":"Instruction Set Architecture","ko":"명령어 집합 구조","definition":"프로그램에 보이는 명령·레지스터·주소 지정·동작 규칙. 이를 구현하는 내부 회로 설계와 구분한다.","target":"runtime--isa","aliases":[],"targets":["runtime--isa"]},{"term":"JIT","full":"Just-In-Time","ko":"실행 시점 컴파일","definition":"프로그램 실행 중 필요한 코드를 기계어 등 실행 표현으로 번역하는 방식. 초기 준비 비용과 이후 재사용 효과를 구분한다.","target":"runtime--runtime-jit","aliases":[],"targets":["runtime--runtime-jit"]},{"term":"JSON","full":"JavaScript Object Notation","ko":"자바스크립트 객체 표기법","definition":"객체·배열·문자열·숫자 등의 값을 텍스트로 교환하는 형식. 객체 참조와 타입을 모두 보존하지는 않는다.","target":"data--data-serialization","aliases":[],"targets":["data--data-serialization"]},{"term":"JWT","full":"JSON Web Token","ko":"JSON 웹 토큰","definition":"이름·값 형식의 클레임을 담는 토큰 형식으로 디코딩과 서명·클레임 검증은 다르다.","target":"security--jwt-validation","aliases":[],"targets":["security--jwt-validation"]},{"term":"KDF","full":"Key Derivation Function","ko":"키 유도 함수","definition":"입력 비밀에서 키 등을 유도하는 함수. 비밀번호 저장용 방식은 추측 비용을 높이는 시간·메모리 설정을 포함한다.","target":"security--password-kdf","aliases":[],"targets":["security--password-kdf"]},{"term":"KiB","full":"Kibibyte","ko":"키비바이트","definition":"1KiB는 1,024바이트다. 1,000바이트인 십진 KB와 구분한다.","target":"io--iops","aliases":[],"targets":["io--iops"]},{"term":"KV","full":"Key-Value","ko":"어텐션의 키·값","definition":"어텐션 계산에 쓰는 Key·Value 벡터. KV 캐시는 과거 토큰의 이 벡터들을 재사용해 생성 과정의 중복 계산을 줄인다.","target":"llm--memory","aliases":["KV cache"],"targets":["llm--memory"]},{"term":"LAN","full":"Local Area Network","ko":"근거리 통신망","definition":"집·사무실 등 제한된 구역 안에서 장치들을 연결한 네트워크.","target":"game-online--game-online-nat","aliases":[],"targets":["game-online--game-online-nat"]},{"term":"LFS","full":"Large File Storage","ko":"대용량 파일 저장","definition":"Git LFS에서 Git에는 포인터를 두고 실제 대용량 파일 내용을 별도로 저장·전달하는 방식.","target":"delivery--large-assets","aliases":["Git LFS"],"targets":["delivery--large-assets"]},{"term":"LLM","full":"Large Language Model","ko":"대규모 언어 모델","definition":"많은 자료에서 학습한 파라미터로 문맥에 이어질 토큰의 분포를 계산하는 언어 모델. 도구 실행이나 최신 검색은 별도 연결이 필요하다.","target":"llm--model","aliases":[],"targets":["llm--model"]},{"term":"LOD","full":"Level of Detail","ko":"세부 수준","definition":"거리나 화면 점유율 등에 따라 사용할 모델·표현의 복잡도를 달리하는 단계.","target":"game--game-lod","aliases":[],"targets":["game--game-lod"]},{"term":"LoRA","full":"Low-Rank Adaptation","ko":"저랭크 적응","definition":"원래 가중치를 고정하고 작은 행렬들의 곱으로 가중치 변화량을 학습하는 미세 조정 방식.","target":"llm--lora","aliases":[],"targets":["llm--lora"]},{"term":"LRU","full":"Least Recently Used","ko":"가장 오래 사용하지 않은 항목 우선 교체","definition":"캐시가 가득 찼을 때 마지막 사용 시점이 가장 오래된 항목을 먼저 내보내는 정책.","target":"io--working-set","aliases":[],"targets":["io--working-set"]},{"term":"LSM","full":"Log-Structured Merge-tree","ko":"로그 구조 병합 트리","definition":"메모리에 모은 변경을 정렬된 파일로 기록하고 파일들을 병합하는 저장 구조.","target":"storage--storage-index-families","aliases":[],"targets":["storage--storage-index-families"]},{"term":"LSP","full":"Language Server Protocol","ko":"언어 서버 프로토콜","definition":"편집기와 언어 분석 서버가 문서 변경·진단·정의·참조·이름 변경 등의 요청과 결과를 주고받는 규약.","target":"environment--language-server","aliases":[],"targets":["environment--language-server"]},{"term":"LSTM","full":"Long Short-Term Memory","ko":"장단기 메모리","definition":"순차 입력에서 상태를 유지·갱신하도록 게이트를 사용하는 순환 신경망 구조. 이 장의 Seq2Seq 원논문에서 사용한다.","target":"ai-papers--seq2seq","aliases":[],"targets":["ai-papers--seq2seq"]},{"term":"MAC","full":"Message Authentication Code","ko":"메시지 인증 코드","definition":"공유 비밀키로 메시지의 무결성과 진위를 검증하는 코드로, 키 보유자는 생성과 검증이 모두 가능하다.","target":"security--mac-signature","aliases":[],"targets":["security--mac-signature"]},{"term":"MB","full":"Megabyte","ko":"메가바이트","definition":"10진 단위로 1MB는 1000000바이트다. 1048576바이트인 1MiB와 구분한다.","target":"math--units","aliases":[],"targets":["math--units"]},{"term":"MCP","full":"Model Context Protocol","ko":"모델 컨텍스트 프로토콜","definition":"AI 애플리케이션이 도구·자료를 발견하고 호출할 때 사용하는 연결 규약. 실제 업무 권한은 서버가 별도로 검사한다.","target":"ai-workflow--protocol","aliases":[],"targets":["ai-workflow--protocol"]},{"term":"MFA","full":"Multifactor Authentication","ko":"다중 요소 인증","definition":"서로 다른 종류의 인증 근거를 조합하는 방식. 같은 비밀번호를 두 번 묻는 것은 다중 요소가 아니다.","target":"security--mfa-passkeys","aliases":[],"targets":["security--mfa-passkeys"]},{"term":"MiB","full":"Mebibyte","ko":"메비바이트","definition":"1MiB는 1,048,576바이트다. 전송량 계산에서 KiB·MiB와 KB·MB를 섞지 않는다.","target":"io--iops","aliases":[],"targets":["io--iops"]},{"term":"MMU","full":"Memory Management Unit","ko":"메모리 관리 장치","definition":"가상 주소를 물리 주소로 변환하고 메모리 접근 권한을 확인하는 하드웨어 구성 요소.","target":"runtime--virtual-memory","aliases":[],"targets":["runtime--virtual-memory"]},{"term":"MoE","full":"Mixture of Experts","ko":"전문가 혼합","definition":"여러 신경망 모듈 중 일부를 입력에 따라 선택해 계산하는 구조. 여러 대화 에이전트가 협업한다는 뜻은 아니다.","target":"llm--moe","aliases":[],"targets":["llm--moe"]},{"term":"MSA","full":"Microservices Architecture","ko":"마이크로서비스 아키텍처","definition":"자율 서비스가 명시적인 계약으로 협력하고 서비스별 독립 배포·운영을 지향하는 구조.","target":"architecture--architecture-service","aliases":[],"targets":["architecture--architecture-service"]},{"term":"MTU","full":"Maximum Transmission Unit","ko":"최대 전송 단위","definition":"한 링크에서 전송하는 IP 패킷 등에 적용되는 최대 크기. 앱 메시지 크기와는 다르다.","target":"networks--mtu","aliases":[],"targets":["networks--mtu"]},{"term":"MVCC","full":"Multiversion Concurrency Control","ko":"다중 버전 동시성 제어","definition":"행의 여러 버전을 관리하고 트랜잭션이 볼 수 있는 버전을 선택하는 방식.","target":"storage--storage-mvcc","aliases":[],"targets":["storage--storage-mvcc"]},{"term":"NAT","full":"Network Address Translation","ko":"네트워크 주소 변환","definition":"네트워크 경계를 통과하는 통신의 IP 주소·포트를 바꾸는 기능.","target":"game-online--game-online-nat","aliases":[],"targets":["game-online--game-online-nat","infra--vpc-routing","networks--nat"]},{"term":"NFC","full":"Normalization Form C","ko":"유니코드 정규화 형식 C","definition":"정준 분해 후 정준 결합을 적용해 동등한 문자열 표현을 정규화하는 방식.","target":"data--data-unicode","aliases":[],"targets":["data--data-unicode"]},{"term":"NUL","full":"Null character","ko":"널 문자","definition":"값 0인 문자. Unix 파일명에 포함될 수 없으므로 파일명 목록을 모호하지 않게 구분하는 데 쓸 수 있다.","target":"environment--batch-arguments","aliases":[],"targets":["environment--batch-arguments"]},{"term":"OAuth","full":"OAuth 2.0 Authorization Framework","ko":"OAuth 2.0 인가 프레임워크","definition":"클라이언트에 외부 자원의 제한된 접근 권한을 위임하는 체계이며 사용자 인증 규약 자체와 구별한다.","target":"security--oauth-oidc","aliases":[],"targets":["security--oauth-oidc"]},{"term":"OCR","full":"Optical Character Recognition","ko":"광학 문자 인식","definition":"이미지에 보이는 글자를 문자 데이터로 변환하는 기술. 표 구조나 문장의 의미까지 정확히 이해한다는 뜻은 아니다.","target":"llm--multimodal","aliases":[],"targets":["llm--multimodal"]},{"term":"OIDC","full":"OpenID Connect","ko":"오픈아이디 커넥트","definition":"OAuth 2.0 위에 사용자 인증 결과를 전달·검증하는 ID 토큰 등의 규칙을 더한 프로토콜.","target":"security--oauth-oidc","aliases":[],"targets":["security--oauth-oidc"]},{"term":"OOM","full":"Out of Memory","ko":"메모리 부족","definition":"필요한 메모리를 확보할 수 없어 할당 실패나 프로세스 종료 등이 발생할 수 있는 상태.","target":"infra--memory-pressure","aliases":[],"targets":["infra--memory-pressure"]},{"term":"ORM","full":"Object-Relational Mapping","ko":"객체 관계 매핑","definition":"프로그램 객체와 관계형 테이블 사이의 읽기·쓰기를 연결하는 방식.","target":"storage--storage-nplusone","aliases":[],"targets":["storage--storage-nplusone"]},{"term":"OS","full":"Operating System","ko":"운영체제","definition":"프로그램 실행과 메모리·파일·장치·권한 등의 자원을 관리하는 시스템 소프트웨어. 커널은 그 핵심 부분이다.","target":"runtime--kernel","aliases":[],"targets":["runtime--kernel"]},{"term":"OTel","full":"OpenTelemetry","ko":"오픈텔레메트리","definition":"로그·메트릭·트레이스 등 관측 자료를 생성·수집·전달하기 위한 공개 표준과 도구 체계.","target":"observability--correlation-trace","aliases":[],"targets":["observability--correlation-trace"]},{"term":"P2P","full":"Peer-to-Peer","ko":"피어 간 연결","definition":"참가자 장치들이 서로 데이터를 주고받는 통신 구성. 누가 게임 상태를 확정하는지는 별도 설계다.","target":"game-online--game-online-topology","aliases":[],"targets":["game-online--game-online-topology"]},{"term":"p95","full":"95th Percentile","ko":"95백분위수","definition":"관측값을 정렬했을 때 약 95%가 그 이하에 놓이는 값으로, 계산 방식과 관측 창을 함께 정해야 한다.","target":"observability--latency","aliases":[],"targets":["observability--latency"]},{"term":"PATH","full":"PATH environment variable","ko":"실행 파일 검색 경로 변수","definition":"약어를 풀어 쓴 규격명은 아니다. 이름만으로 명령을 실행할 때 검색할 디렉터리 목록을 담는 환경 변수 이름이다.","target":"environment--path-env","aliases":[],"targets":["environment--path-env"]},{"term":"PBR","full":"Physically Based Rendering","ko":"물리 기반 렌더링","definition":"빛과 재질의 물리적 성질을 근사해 일관된 조명 반응을 계산하는 렌더링 접근.","target":"game--game-pbr","aliases":[],"targets":["game--game-pbr"]},{"term":"PBT","full":"Property-Based Testing","ko":"속성 기반 테스트","definition":"여러 입력을 생성해 항상 성립해야 하는 성질을 검사하고 실패 입력을 축소하는 방식.","target":"debugging--property-testing","aliases":[],"targets":["debugging--property-testing"]},{"term":"PCIe","full":"Peripheral Component Interconnect Express","ko":"PCI 익스프레스","definition":"CPU·칩셋과 그래픽카드·저장장치 등을 연결하는 고속 직렬 연결 규격. 세대와 레인 수에 따라 대역폭이 달라진다.","target":"runtime--data-path","aliases":["PCI Express"],"targets":["runtime--data-path"]},{"term":"PID","full":"Process Identifier","ko":"프로세스 식별자","definition":"운영체제가 실행 중인 프로세스를 식별하는 번호. 종료 뒤 같은 번호가 다른 프로세스에 재사용될 수 있다.","target":"environment--process-life","aliases":[],"targets":["environment--process-life"]},{"term":"PII","full":"Personally Identifiable Information","ko":"개인 식별 정보","definition":"직접 또는 다른 정보와 결합해 특정 개인을 식별할 수 있는 정보.","target":"security--personal-data","aliases":[],"targets":["security--personal-data"]},{"term":"PIN","full":"Personal Identification Number","ko":"개인 식별 번호","definition":"기기 잠금 해제나 인증기 사용을 허용할 때 입력하는 번호. 패스키에서 사이트로 보내는 계정 비밀번호와 구분한다.","target":"security--mfa-passkeys","aliases":[],"targets":["security--mfa-passkeys"]},{"term":"PITR","full":"Point-in-Time Recovery","ko":"시점 복구","definition":"기준 백업과 변경 로그를 이용해 지정한 시점까지 상태를 복구하는 방법.","target":"storage--storage-pitr","aliases":[],"targets":["storage--storage-pitr"]},{"term":"PKCE","full":"Proof Key for Code Exchange","ko":"인가 코드 교환 증명 키","definition":"코드 요청 때의 검증 자료와 교환 때의 비밀 검증값을 연결해 인가 코드 탈취 위험을 줄이는 방식.","target":"security--oauth-oidc","aliases":[],"targets":["security--oauth-oidc"]},{"term":"PNG","full":"Portable Network Graphics","ko":"포터블 네트워크 그래픽스","definition":"무손실 압축을 사용하는 래스터 이미지 파일 형식. 파일 크기와 GPU에 펼친 텍스처 크기는 다르다.","target":"game--game-textures","aliases":[],"targets":["game--game-textures"]},{"term":"POSIX","full":"Portable Operating System Interface","ko":"이식 가능한 운영체제 인터페이스","definition":"운영체제 API와 셸·도구의 동작을 표준화한 계열. 셸마다 모든 확장 기능이 같은 것은 아니다.","target":"environment--shell","aliases":[],"targets":["environment--shell"]},{"term":"PPO","full":"Proximal Policy Optimization","ko":"근접 정책 최적화","definition":"정책이 한 번에 지나치게 바뀌는 것을 제어하며 보상을 높이는 강화학습 방법. InstructGPT 원논문에서 사용했다.","target":"ai-papers--instructgpt","aliases":[],"targets":["ai-papers--instructgpt"]},{"term":"PR","full":"Pull Request","ko":"변경 검토·병합 요청","definition":"브랜치의 변경을 검토하고 다른 브랜치에 합치도록 제안하는 요청.","target":"delivery--review","aliases":[],"targets":["delivery--review"]},{"term":"PSU","full":"Power Supply Unit","ko":"전원공급장치","definition":"컴퓨터 부품에 필요한 전원을 공급하는 장치. 명령을 처리하거나 데이터를 저장하는 부품은 아니다.","target":"runtime--computer-body","aliases":[],"targets":["runtime--computer-body"]},{"term":"QUIC","full":"QUIC (protocol name)","ko":"QUIC 전송 프로토콜","definition":"현재 표준에서는 약어를 풀어 쓴 규격명이 아닌 프로토콜 이름이다. UDP 위에 스트림·신뢰성·보안 등의 기능을 제공하며 HTTP/3가 사용한다.","target":"networks--http-multiplexing","aliases":[],"targets":["networks--http-multiplexing"]},{"term":"RAG","full":"Retrieval-Augmented Generation","ko":"검색 증강 생성","definition":"외부 자료를 검색해 모델 입력에 넣고 그 근거를 활용해 결과를 생성하는 구성.","target":"ai-workflow--retrieval","aliases":[],"targets":["ai-workflow--retrieval"]},{"term":"RAII","full":"Resource Acquisition Is Initialization","ko":"객체 수명에 결합한 자원 관리","definition":"C++에서 자원 소유를 객체 초기화와 연결하고 소멸자에서 반환하는 기법. 파일·락 등도 객체 수명으로 정리한다.","target":"runtime--resource-lifetime","aliases":[],"targets":["runtime--resource-lifetime"]},{"term":"RAM","full":"Random Access Memory","ko":"임의 접근 메모리·주기억장치","definition":"실행 중인 코드와 데이터를 두는 작업 공간. 일반적인 DRAM은 전원이 꺼지면 내용을 잃는다.","target":"runtime--memory-tiers","aliases":[],"targets":["runtime--memory-tiers"]},{"term":"RBAC","full":"Role-Based Access Control","ko":"역할 기반 접근 제어","definition":"사용자 등의 역할에 연결된 권한으로 작업 허용 여부를 판단하는 방식.","target":"security--rbac-abac","aliases":[],"targets":["security--rbac-abac"]},{"term":"ReAct","full":"Reasoning and Acting","ko":"판단과 행동의 결합","definition":"언어 모델의 상태 판단·행동 요청·외부 관측을 번갈아 연결하는 작업 방식.","target":"ai-papers--react","aliases":[],"targets":["ai-papers--react"]},{"term":"RED","full":"Rate, Errors, Duration","ko":"요청률·오류·소요 시간","definition":"요청을 처리하는 서비스의 부하·실패·지연을 함께 보는 관측 기준.","target":"observability--red-use","aliases":[],"targets":["observability--red-use"]},{"term":"ReLU","full":"Rectified Linear Unit","ko":"정류 선형 단위","definition":"입력이 음수이면 0을, 0 이상이면 입력을 그대로 내보내는 활성화 함수. 식은 max(0,x)다.","target":"ai-math--nonlinearity","aliases":[],"targets":["ai-math--nonlinearity"]},{"term":"ResNet","full":"Residual Network","ko":"잔차 신경망","definition":"입력과 학습한 변화량을 더하는 잔차 연결을 사용하는 신경망 계열.","target":"ai-papers--resnet","aliases":[],"targets":["ai-papers--resnet"]},{"term":"RGBA","full":"Red, Green, Blue, Alpha","ko":"빨강·초록·파랑·알파","definition":"색 세 성분과 투명도 등 합성에 쓰는 알파 성분. RGBA8은 보통 성분당 8비트다.","target":"game--game-textures","aliases":[],"targets":["game--game-textures"]},{"term":"RLHF","full":"Reinforcement Learning from Human Feedback","ko":"사람의 피드백을 활용한 강화학습","definition":"사람의 비교 판단 등에서 얻은 보상 신호로 모델의 응답 정책을 조정하는 학습 방식.","target":"ai-papers--instructgpt","aliases":[],"targets":["ai-papers--instructgpt"]},{"term":"RPC","full":"Remote Procedure Call","ko":"원격 프로시저 호출","definition":"다른 프로세스나 장치의 기능을 호출하도록 요청·응답을 주고받는 방식. 로컬 호출과 달리 지연·중복·결과 불명이 생길 수 있다.","target":"game-online--game-online-rpc","aliases":[],"targets":["game-online--game-online-rpc"]},{"term":"RPM","full":"Requests Per Minute","ko":"분당 요청 수","definition":"1분 기준 요청 수를 나타내는 단위. 제공자의 한도 계산 구간과 실패 요청 포함 규칙은 별도로 확인한다.","target":"llm--limits","aliases":[],"targets":["llm--limits"]},{"term":"RPO","full":"Recovery Point Objective","ko":"복구 시점 목표","definition":"장애 때 허용할 수 있는 데이터 손실 범위를 시간으로 표현한 목표. 실제 복구 가능 지점과 대조한다.","target":"security--backup-recovery","aliases":[],"targets":["security--backup-recovery","storage--storage-backup"]},{"term":"RST","full":"Reset","ko":"연결 리셋 플래그","definition":"TCP 연결을 중단하거나 유효하지 않은 연결 시도를 거절할 때 쓰는 제어 플래그.","target":"networks--tcp-lifecycle","aliases":[],"targets":["networks--tcp-lifecycle"]},{"term":"RTO","full":"Recovery Time Objective","ko":"복구 시간 목표","definition":"장애 후 서비스 복구까지 허용하는 시간 목표. 실제 복원·검증 시간과 대조한다.","target":"security--backup-recovery","aliases":[],"targets":["security--backup-recovery","storage--storage-backup"]},{"term":"RTT","full":"Round-Trip Time","ko":"왕복 시간","definition":"메시지를 보내고 대응하는 응답이 돌아오기까지의 시간. 한 방향 지연과 같지 않다.","target":"game-online--game-online-latency","aliases":[],"targets":["game-online--game-online-latency","networks--network-time"]},{"term":"SBOM","full":"Software Bill of Materials","ko":"소프트웨어 구성 명세서","definition":"산출물에 포함된 소프트웨어 구성 요소와 버전 등의 관계를 기록한 목록.","target":"security--sbom-triage","aliases":[],"targets":["security--sbom-triage"]},{"term":"SDK","full":"Software Development Kit","ko":"소프트웨어 개발 키트","definition":"특정 플랫폼·서비스 개발에 필요한 라이브러리·도구·문서 등을 묶은 개발 도구 모음.","target":"runtime--sdk","aliases":[],"targets":["runtime--sdk"]},{"term":"SemVer","full":"Semantic Versioning","ko":"유의적 버전","definition":"공개 인터페이스의 호환성 변화에 따라 주·부·수정 버전을 구분하는 버전 규칙.","target":"delivery--semver","aliases":[],"targets":["delivery--semver"]},{"term":"SFT","full":"Supervised Fine-Tuning","ko":"지도 미세 조정","definition":"요청과 좋은 응답 같은 정답 예시로 사전학습 모델의 가중치를 추가 조정하는 방식.","target":"ai-papers--instructgpt","aliases":[],"targets":["ai-papers--instructgpt"]},{"term":"SLI","full":"Service Level Indicator","ko":"서비스 수준 지표","definition":"정해진 측정 범위에서 성공률·지연 등 서비스 동작을 수치로 나타내는 지표.","target":"observability--slo","aliases":[],"targets":["observability--slo"]},{"term":"SLO","full":"Service Level Objective","ko":"서비스 수준 목표","definition":"정해진 기간과 대상에서 SLI가 만족하도록 정한 목표.","target":"observability--slo","aliases":[],"targets":["observability--slo"]},{"term":"SoA","full":"Structure of Arrays","ko":"배열들의 구조체","definition":"각 필드를 별도 배열에 모아 같은 속성을 연속 처리하는 배치 방식. 위치만 반복 갱신하는 작업 등에 유리할 수 있다.","target":"runtime--data-layout","aliases":["SOA"],"targets":["runtime--data-layout"]},{"term":"SoC","full":"System on Chip","ko":"단일 칩 시스템","definition":"CPU·메모리 제어·주변 장치 등 여러 시스템 기능을 한 칩에 통합한 구성. 모든 RAM과 저장장치까지 반드시 포함하는 것은 아니다.","target":"runtime--computer-body","aliases":[],"targets":["runtime--computer-body"]},{"term":"SQL","full":"Structured Query Language","ko":"구조화 질의 언어","definition":"관계형 데이터를 정의·조회·변경하기 위한 선언적 언어.","target":"storage--storage-sql","aliases":[],"targets":["storage--storage-sql"]},{"term":"sRGB","full":"standard Red Green Blue","ko":"표준 RGB 색 공간","definition":"색 원색·백색점과 선형 빛을 저장 값으로 바꾸는 전송 함수를 정의한 색 공간.","target":"game--game-color","aliases":[],"targets":["game--game-color"]},{"term":"SSD","full":"Solid-State Drive","ko":"반도체 저장장치","definition":"주로 비휘발성 플래시 메모리로 파일을 보관하는 장치. 실행 중인 RAM의 용량과 별개다.","target":"runtime--memory-tiers","aliases":[],"targets":["runtime--memory-tiers"]},{"term":"SSE","full":"Server-Sent Events","ko":"서버 발신 이벤트","definition":"서버가 열린 HTTP 응답을 통해 브라우저로 이벤트를 계속 전달하는 단방향 방식.","target":"networks--sse","aliases":[],"targets":["networks--sse"]},{"term":"SSH","full":"Secure Shell","ko":"보안 셸","definition":"암호화와 인증을 사용해 원격 컴퓨터에 접속하고 명령·파일 전송을 수행하는 통신 규칙.","target":"environment--remote","aliases":[],"targets":["environment--remote"]},{"term":"SSHFS","full":"SSH Filesystem","ko":"SSH 기반 파일시스템","definition":"원격 파일을 SSH 연결을 통해 로컬의 파일 인터페이스로 다루는 FUSE 파일시스템 구현.","target":"io--fuse-mounts","targets":["io--fuse-mounts"]},{"term":"SSRF","full":"Server-Side Request Forgery","ko":"서버 측 요청 위조","definition":"외부 입력을 통해 서버가 의도하지 않은 내부·외부 대상으로 접속하게 만드는 공격.","target":"security--ssrf","aliases":[],"targets":["security--ssrf"]},{"term":"SYN","full":"Synchronize","ko":"연결 초기 순서 동기화 플래그","definition":"TCP 연결 시작 때 초기 순서 번호를 맞추는 데 쓰는 제어 플래그.","target":"networks--tcp-lifecycle","aliases":[],"targets":["networks--tcp-lifecycle"]},{"term":"TCP","full":"Transmission Control Protocol","ko":"전송 제어 프로토콜","definition":"연결 위에서 순서 있는 신뢰성 있는 바이트 흐름을 제공하는 전송 규칙. 앱 메시지 경계는 보존하지 않는다.","target":"networks--tcp-udp","aliases":[],"targets":["networks--tcp-udp"]},{"term":"TDD","full":"Test-Driven Development","ko":"테스트 주도 개발","definition":"실패하는 기대 동작의 테스트부터 시작해 구현과 구조 개선을 반복하는 개발 방식.","target":"debugging--unit","aliases":[],"targets":["debugging--unit"]},{"term":"TLB","full":"Translation Lookaside Buffer","ko":"주소 변환 캐시","definition":"최근 주소 변환 정보를 보관해 페이지 표를 매번 따라가는 비용을 줄이는 캐시. 데이터 내용 자체를 저장하는 CPU 캐시와 구분한다.","target":"runtime--virtual-memory","aliases":[],"targets":["runtime--virtual-memory"]},{"term":"TLS","full":"Transport Layer Security","ko":"전송 계층 보안","definition":"통신 상대를 인증하고 내용의 기밀성과 변조 탐지를 제공하는 보안 프로토콜.","target":"networks--tls","aliases":[],"targets":["networks--tls","security--tls-certificates"]},{"term":"TOTP","full":"Time-Based One-Time Password","ko":"시간 기반 일회용 비밀번호","definition":"공유 비밀과 현재 시간 구간을 사용해 바뀌는 인증 코드를 만드는 방식. 피싱에 대한 저항성은 패스키와 다르다.","target":"security--mfa-passkeys","aliases":[],"targets":["security--mfa-passkeys"]},{"term":"TPM","full":"Tokens Per Minute","ko":"분당 토큰 수","definition":"1분 기준 처리하거나 허용하는 토큰 수. 입력·출력·캐시 토큰의 포함 방식은 제공자와 한도 종류에 따라 다르다.","target":"llm--limits","aliases":[],"targets":["llm--limits"]},{"term":"TSan","full":"ThreadSanitizer","ko":"자료 경쟁 검사기","definition":"여러 스레드의 메모리 접근에서 자료 경쟁을 검사하는 도구.","target":"debugging--memory-sanitizer","aliases":[],"targets":["debugging--memory-sanitizer"]},{"term":"TTFB","full":"Time To First Byte","ko":"첫 바이트까지의 시간","definition":"응답의 첫 바이트가 도착할 때까지의 시간. 측정 범위와 네트워크 지연을 함께 해석한다.","target":"networks--devtools-network","aliases":[],"targets":["networks--devtools-network"]},{"term":"TTFT","full":"Time to First Token","ko":"첫 토큰까지의 시간","definition":"요청을 보낸 뒤 첫 출력 토큰을 받기까지 걸린 시간. 마지막 토큰까지의 전체 완료 시간과 다르다.","target":"llm--latency","aliases":[],"targets":["llm--latency"]},{"term":"TTL","full":"Time To Live","ko":"캐시 보관 시간","definition":"DNS에서는 기록을 캐시에 재사용할 수 있는 시간이다. IP 패킷의 TTL은 전달 홉 제한이라는 다른 문맥이다.","target":"networks--dns","aliases":[],"targets":["networks--dns"]},{"term":"UBSan","full":"UndefinedBehaviorSanitizer","ko":"미정의 동작 검사기","definition":"지원하는 미정의 동작을 실행 중 검사하는 도구.","target":"debugging--memory-sanitizer","aliases":[],"targets":["debugging--memory-sanitizer"]},{"term":"UDP","full":"User Datagram Protocol","ko":"사용자 데이터그램 프로토콜","definition":"개별 데이터그램을 전달하는 전송 규칙. 자체적인 도착·순서·중복 방지 보장은 없다.","target":"networks--tcp-udp","aliases":[],"targets":["networks--tcp-udp"]},{"term":"UEFI","full":"Unified Extensible Firmware Interface","ko":"통합 확장 펌웨어 인터페이스","definition":"컴퓨터의 초기 하드웨어 설정과 운영체제 부팅을 연결하는 펌웨어 인터페이스 표준.","target":"runtime--boot-chain","targets":["runtime--boot-chain"]},{"term":"UI","full":"User Interface","ko":"사용자 인터페이스","definition":"사용자가 상태를 보고 입력하는 화면과 조작 수단.","target":"state--state-ui-states","aliases":[],"targets":["state--state-ui-states"]},{"term":"URL","full":"Uniform Resource Locator","ko":"자원 위치 식별자","definition":"접근 방식·호스트·경로·질의 등을 표현해 자원의 위치를 나타내는 문자열.","target":"networks--http-message","aliases":[],"targets":["networks--http-message"]},{"term":"USB","full":"Universal Serial Bus","ko":"범용 직렬 버스","definition":"컴퓨터와 주변 장치 사이의 데이터 전달·전원 연결에 쓰는 규격 계열. 같은 커넥터 모양이 같은 속도와 기능을 보장하지는 않는다.","target":"runtime--data-path","aliases":[],"targets":["runtime--data-path"]},{"term":"USE","full":"Utilization, Saturation, Errors","ko":"사용률·포화·오류","definition":"CPU·메모리·연결 풀 같은 자원의 사용량과 대기·오류를 보는 관측 기준.","target":"observability--red-use","aliases":[],"targets":["observability--red-use"]},{"term":"UTC","full":"Coordinated Universal Time","ko":"협정 세계시","definition":"시간대 오프셋을 표현할 때 기준으로 사용하는 시간 척도.","target":"data--data-time","aliases":[],"targets":["data--data-time","environment--locale-time","observability--parse-normalize"]},{"term":"UTF-16LE","full":"Unicode Transformation Format, 16-bit, Little-Endian","ko":"리틀엔디언 UTF-16","definition":"문자를 16비트 코드 단위로 표현하고 각 단위의 낮은 바이트를 먼저 저장하는 유니코드 인코딩.","target":"environment--files","aliases":["UTF16LE"],"targets":["environment--files"]},{"term":"UTF-8","full":"Unicode Transformation Format, 8-bit","ko":"8비트 단위 유니코드 변환 형식","definition":"유니코드 코드 포인트를 1~4바이트로 인코딩하는 방식.","target":"data--data-unicode","aliases":[],"targets":["data--data-unicode"]},{"term":"vCPU","full":"Virtual Central Processing Unit","ko":"가상 CPU","definition":"가상 머신에 보이는 CPU 실행 단위로, 항상 독점 물리 코어와 같지는 않다.","target":"infra--hypervisor","aliases":[],"targets":["infra--hypervisor"]},{"term":"VM","full":"Virtual Machine","ko":"가상 머신","definition":"가상 하드웨어 위에서 별도의 운영체제를 실행하는 환경. Python 가상 환경과는 격리 범위가 다르다.","target":"environment--isolation","aliases":[],"targets":["environment--isolation","infra--vm-container"]},{"term":"VPC","full":"Virtual Private Cloud","ko":"가상 사설 클라우드","definition":"클라우드 안에서 주소 범위·서브넷·경로 등을 구성하는 논리적 네트워크 공간.","target":"infra--vpc-routing","aliases":[],"targets":["infra--vpc-routing"]},{"term":"VPN","full":"Virtual Private Network","ko":"가상 사설망","definition":"공유 네트워크 위에서 별도의 논리적 연결을 구성해 통신하는 방식. 접속 시 경로·DNS 설정이 달라질 수 있다.","target":"networks--vpn-boundary","aliases":[],"targets":["networks--vpn-boundary"]},{"term":"VRAM","full":"Video Random Access Memory","ko":"비디오 메모리","definition":"GPU가 그래픽·계산 자료를 보관하는 메모리를 부르는 말. 전용 메모리와 CPU·GPU 공유 메모리 구성을 구분한다.","target":"runtime--memory-tiers","aliases":[],"targets":["runtime--memory-tiers"]},{"term":"WAL","full":"Write-Ahead Logging","ko":"선행 기록 로깅","definition":"변경된 데이터 페이지를 영구 기록하기 전에 복구 로그를 먼저 영구 기록하는 원칙.","target":"storage--storage-wal","aliases":[],"targets":["storage--storage-wal"]},{"term":"WebAuthn","full":"Web Authentication","ko":"웹 인증","definition":"공개키 자격증명을 사용하는 등록·인증을 브라우저에서 제공하는 API. 서비스 식별과 출처 검증이 중요하다.","target":"security--mfa-passkeys","aliases":[],"targets":["security--mfa-passkeys"]},{"term":"XSS","full":"Cross-Site Scripting","ko":"사이트 간 스크립팅","definition":"신뢰하지 않는 입력이 웹 문맥에서 실행 코드로 해석돼 사용자의 브라우저에서 실행되는 취약점.","target":"security--xss","aliases":[],"targets":["security--xss"]}]